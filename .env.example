# Copy to .env.local and fill in. Never commit .env.local, and never paste keys into chat.

# --- Personal Supabase project ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: bypasses row level security. Seed and content scripts only, never the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Content engine: AI providers ------------------------------------------------------------
# Tried in order; the first to succeed wins. Available: mistral, openrouter, groq, gemini, openai.
CONTENT_PROVIDERS=mistral,openrouter

# Every *_MODEL setting is a preference list: models are tried left to right, and a retired
# model is skipped automatically. `npm run content -- models` shows which are still served.

# Primary. Key from https://console.mistral.ai (free Experiment tier).
MISTRAL_API_KEY=
CONTENT_MISTRAL_MODEL=ministral-14b-latest,ministral-8b-latest,mistral-medium-latest
# CONTENT_MISTRAL_DAILY_CALLS=100

# Fallback. Key from https://openrouter.ai/keys (no card needed).
# Free models end in ":free" and change often. Only some support the strict JSON schema the engine
# needs; as of 2026-09-23 that was qwen3.8-27b, nex-n2.5-pro/-mini and dots-3-note-preview. When one
# retires, run `npm run content -- models` and update this list.
OPENROUTER_API_KEY=
CONTENT_OPENROUTER_MODEL=qwen/qwen3.8-27b:free,nex-agi/nex-n2.5-pro:free
# About 50 free requests a day across all free models, so cap it there.
CONTENT_OPENROUTER_DAILY_CALLS=50

# Optional. Add to CONTENT_PROVIDERS to use. Key from https://console.groq.com/keys
# GROQ_API_KEY=
# CONTENT_GROQ_MODEL=qwen/qwen3.8-27b,qwen/qwen3-32b
# Optional, Qwen only: none | default | low | medium | high. Unset lets Groq choose.
# CONTENT_GROQ_REASONING_EFFORT=

# Not offered free in the UK.
# GEMINI_API_KEY=
# CONTENT_GEMINI_MODEL=gemini-flash-lite-latest

# Optional paid provider, only if listed in CONTENT_PROVIDERS.
# OPENAI_API_KEY=
# CONTENT_OPENAI_MODEL=
# CONTENT_OPENAI_INPUT_USD_PER_MILLION=
# CONTENT_OPENAI_OUTPUT_USD_PER_MILLION=

# Spend cap across all providers, USD per day. 0 = free calls only; nothing can bill you.
CONTENT_DAILY_USD=0

# --- Content engine: behaviour ---------------------------------------------------------------
# Publish posts that pass the source-excerpt checks and the model review, without you approving each.
CONTENT_AUTO_PUBLISH=false
# New candidates drafted per run (each costs up to two calls: draft, then review).
CONTENT_DRAFT_LIMIT=8
# Unread posts to keep queued ahead of you.
CONTENT_QUEUE_TARGET=24
# Hours before an article whose draft was held is tried again. 0 retries held articles on every run.
# CONTENT_RETRY_HELD_HOURS=24
# Characters of each article sent to the model. Keeps both calls inside small per-minute token limits.
# CONTENT_SOURCE_CHARS=10000
# CONTENT_MAX_OUTPUT_TOKENS=2500
# Longest retry-after (seconds) worth waiting for once, before falling back instead.
# CONTENT_MAX_WAIT_SECONDS=60
# Wait after a 429 that gives no retry-after (Mistral's free tier often doesn't).
# CONTENT_RATE_LIMIT_WAIT_SECONDS=60
# Minimum gap between calls to one provider, in milliseconds. Raise it if you still see 429s.
# CONTENT_MISTRAL_MIN_INTERVAL_MS=3000
# CONTENT_OPENROUTER_MIN_INTERVAL_MS=3000

# --- Disposable test project (browser suite only; destructive) --------------------------------
PLAYWRIGHT_SUPABASE_URL=
PLAYWRIGHT_SUPABASE_PUBLISHABLE_KEY=
PLAYWRIGHT_SUPABASE_SERVICE_ROLE_KEY=
